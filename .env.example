# ==============================================================================
# .env.example — TEMPLATE VARIABEL LINGKUNGAN & KUNCI API (RAHASIA)
# ==============================================================================
# INSTRUKSI KEAMANAN:
# 1. Salin berkas ini ke `.env`: cp .env.example .env
# 2. Isi nilai rahasia di dalam berkas `.env` Anda sendiri.
# 3. JANGAN PERNAH meng-commit berkas `.env` ke Git / GitHub!
#    Berkas `.env` sudah secara otomatis diabaikan oleh `.gitignore`.
# ==============================================================================

# --- YOUTUBE DATA API V3 (Google Cloud Console) ---
# Digunakan oleh: scripts/youtube_network.py, yt_collect.py
YT_API_KEY=your_youtube_api_key_here
# Salt acak untuk pseudonimisasi satu arah komentator YouTube (UU PDP No. 27/2022)
YT_SALT=your_random_secret_salt_here

# --- APIFY & WEB CRAWLING ---
# Digunakan oleh: crawl_instagram_apify.js
APIFY_TOKEN=your_apify_api_token_here

# --- INSTAGRAM SCRAPER SESSION (OPSIONAL) ---
# Digunakan oleh: run_crawler.py
IG_USERNAME=your_instagram_username_here

# --- LLM & AI ANNOTATION (OPSIONAL) ---
# Digunakan oleh: llm_annotate.py (jika menggunakan model eksternal)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- STREAMLIT CONFIGURATION ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
