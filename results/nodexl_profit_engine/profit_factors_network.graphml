    <node id="F3_RELEASE_TIMING"><data key="label">3. 📅 Timing Rilis & Libur Lebaran</data><data key="category">Strategic Factor</data><data key="color">#1D4ED8</data><data key="size">28</data></node>
    <node id="F4_HOOK_IP_CAST"><data key="label">4. 🪝 Hook: IP Kuat & Bintang Jangkar</data><data key="category">Strategic Factor</data><data key="color">#7C3AED</data><data key="size">28</data></node>
    <node id="F5_STORY_WOM"><data key="label">5. 🗣️ Cerita Solid & Word-of-Mouth</data><data key="category">Strategic Factor</data><data key="color">#D97706</data><data key="size">28</data></node>
    <node id="F6_REVENUE_DIVERSE"><data key="label">6. 📺 Diversifikasi Aliran Pendapatan</data><data key="category">Strategic Factor</data><data key="color">#0F766E</data><data key="size">28</data></node>
    <node id="L1_OPENING_WEEK"><data key="label">⚡ Opening Weekend (D1-D4)</data><data key="category">Operational Lever</data><data key="color">#EA580C</data><data key="size">22</data></node>
    <node id="L2_LONG_TAIL_LEGS"><data key="label">📈 Theatrical Long-Tail Legs</data><data key="category">Operational Lever</data><data key="color">#EAB308</data><data key="size">22</data></node>
    <node id="L3_LOW_BEP_THRESH"><data key="label">🎯 Titik Impas (BEP Rendah)</data><data key="category">Financial Lever</data><data key="color">#10B981</data><data key="size">22</data></node>
    <node id="L4_EXHIBITOR_SCREENS"><data key="label">🏢 Alokasi Layar Bioskop (XXI/CGV)</data><data key="category">Operational Lever</data><data key="color">#3B82F6</data><data key="size">20</data></node>
    <node id="L5_OTT_PRESALE_MG"><data key="label">🛡️ Minimum Guarantee (MG) OTT</data><data key="category">Financial Lever</data><data key="color">#14B8A6</data><data key="size">22</data></node>
    <node id="L6_NET_PRODUCER_SHARE"><data key="label">💵 Net Bagian Produser (42.5%)</data><data key="category">Financial Lever</data><data key="color">#991B1B</data><data key="size">24</data></node>
    <edge id="e0" source="F4_HOOK_IP_CAST" target="L1_OPENING_WEEK"><data key="rel">DRIVES_ADMISSIONS</data><data key="weight">9.5</data></edge>
    <edge id="e1" source="F1_GENRE_FIT" target="L1_OPENING_WEEK"><data key="rel">SUPPORTS_DEMAND</data><data key="weight">8.0</data></edge>
